            "body": {
              "mode": "raw",
              "raw": "{\n  \"DirectoryId\": \"d-a5ada4ed1b\",\n  \"UserName\": \"l9n\",\n  \"NewPassword\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
