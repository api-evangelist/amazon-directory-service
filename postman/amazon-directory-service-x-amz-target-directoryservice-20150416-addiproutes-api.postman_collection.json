              "raw": "{\n  \"DirectoryId\": \"d-770e689599\",\n  \"IpRoutes\": [\n    {\n      \"CidrIp\": \"241.148.81.94/26\",\n      \"Description\": \"JZZ\u200a?:E!\u2003\"\n    },\n    {\n      \"CidrIp\": \"17.109.144.255/25\",\n      \"Description\": \"c3m%!Zsn\u2008E\"\n    }\n  ],\n  \"UpdateSecurityGroupForDirectoryControllers\": \"<boolean>\"\n}",
