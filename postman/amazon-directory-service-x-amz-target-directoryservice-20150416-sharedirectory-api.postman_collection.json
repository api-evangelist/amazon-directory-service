            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"DirectoryId\": \"d-8dae2a4e2b\",\n  \"ShareTarget\": {\n    \"Id\": \"<string>\",\n    \"Type\": \"ACCOUNT\"\n  },\n  \"ShareMethod\": \"ORGANIZATIONS\",\n  \"ShareNotes\": \"<string>\"\n}",
              "options": {
                "raw": {
